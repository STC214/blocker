+            return delegate.deleteRules(packageName)
+        }
+
+        override suspend fun fileExists(packageName: String): Boolean = delegate.fileExists(packageName)
+        override suspend fun listRuleFiles(): List<String> = delegate.listRuleFiles()
+    }
